# ── LLM — Groq (free at console.groq.com) ──────────────────────────────────
# Models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
GROQ_API_KEY=gsk_your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ── Voice TTS ───────────────────────────────────────────────────────────────
# coqui  → self-hosted XTTS v2 (free, run on Colab — see colab/ folder)
# elevenlabs → cloud API (paid, faster)
VOICE_PROVIDER=coqui
COQUI_API_URL=https://xxxx-xx-xx.ngrok-free.app   # URL printed by Colab notebook

ELEVENLABS_API_KEY=   # only needed if VOICE_PROVIDER=elevenlabs

# ── STT ─────────────────────────────────────────────────────────────────────
# Browser WebSpeech API is used by default (no key needed).
# Set STT_PROVIDER=whisper + OPENAI_API_KEY for higher accuracy.
STT_PROVIDER=whisper
OPENAI_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
